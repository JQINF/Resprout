{
  "name": "resprout",
  "version": "0.1.0-alpha.3",
  "description": "A canvas for divergent learning. Branch from curiosity and build your own map of understanding.",
  "type": "module",
  "license": "MIT",
  "author": "Resprout contributors",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "keywords": [
    "divergent-learning",
    "ai",
    "llm",
    "canvas",
    "branching-chat",
    "learning"
  ],
  "bin": {
    "resprout": "dist/node/bin/resprout.js"
  },
  "files": [
    "dist/",
    "README.en.md",
    "assets/readme/",
    "assets/brand/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node dist/node/bin/resprout.js",
    "dev": "node scripts/dev.ts",
    "dev:vite": "vite",
    "sidecar": "node sidecar/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.node.json && node scripts/copy-interactive-assets.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:browser": "node tests/browser/run.ts",
    "test:baseline": "node tests/browser/run.ts --check-baseline",
    "prepack": "npm run build",
    "test:agent": "node tests/browser/agent-smoke.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@mozilla/readability": "^0.6.0",
    "@xyflow/react": "^12.12.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "linkedom": "^0.18.15",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
