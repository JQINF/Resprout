{
  "name": "resprout",
  "version": "0.1.0-alpha.0",
  "description": "A canvas for divergent learning. Branch from curiosity and build your own map of understanding.",
  "type": "module",
  "license": "MIT",
  "author": "Resprout contributors",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "keywords": [
    "divergent-learning",
    "ai",
    "llm",
    "canvas",
    "branching-chat",
    "learning"
  ],
  "bin": {
    "resprout": "bin/resprout.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "sidecar/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node bin/resprout.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "sidecar": "node sidecar/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2",
    "@xyflow/react": "^12.12.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.5"
  }
}
